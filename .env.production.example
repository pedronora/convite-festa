# Produção — copie para .env e ajuste os valores antes de subir.
# Use uma senha longa e sem caracteres que precisem de escape em URL
# (letras, números, hífen e sublinhado são seguros).

POSTGRES_DB=convite_festa
POSTGRES_USER=convite
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica

# URL pública que aparece nos links enviados por WhatsApp (sem barra final).
APP_URL=https://convite.seudominio.com
APP_PORT=3000

# Rode as migrations automaticamente ao iniciar o container.
RUN_MIGRATIONS=true
