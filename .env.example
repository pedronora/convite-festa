# Banco de dados
DATABASE_URL=postgres://convite:convite@localhost:5433/convite_festa

# URL pública usada nos links de convite (sem barra no final)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Pasta persistente para imagens enviadas
DATA_DIR=./.data

# Primeiro administrador (usado apenas pelos scripts de seed/create-admin)
# Defina uma senha com ao menos 12 caracteres, diferente dos exemplos do projeto.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@festa.local
ADMIN_PASSWORD=

# Seed de demonstração (defina false em produção)
SEED_SAMPLE=true
